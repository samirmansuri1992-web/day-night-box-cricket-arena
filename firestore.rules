rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["YOUR_ADMIN_EMAIL@example.com"];
    }
    // Only time range and status are public; no customer name or phone is stored here.
    match /occupiedSlots/{bookingId} {
      allow read: if true;
      allow create: if request.resource.data.groundId == "day-night-box-cricket-arena"
        && request.resource.data.status == "pending"
        && request.resource.data.startAt is number
        && request.resource.data.endAt is number
        && request.resource.data.endAt > request.resource.data.startAt;
      allow update, delete: if isAdmin();
    }
    // Customer contact details are admin-only.
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.groundId == "day-night-box-cricket-arena"
        && request.resource.data.status == "pending"
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.startAt is number
        && request.resource.data.endAt is number
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.price is number;
      allow update, delete: if isAdmin();
    }
  }
}